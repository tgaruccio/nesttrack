<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>What's Your Home Worth?</title>
<style>
  :root{ --accent:#2A6EF4; --ink:#0F1B33; --muted:#5b6472; --line:#e6e9ef; --bg:#f4f6fb; }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;color:var(--ink);background:var(--bg);line-height:1.5;-webkit-font-smoothing:antialiased;}
  .wrap{max-width:560px;margin:0 auto;padding:0 18px 48px;}
  .topbar{display:flex;align-items:center;gap:12px;padding:18px 2px 8px;}
  .topbar img{width:46px;height:46px;border-radius:50%;object-fit:cover;background:#dde3ee;flex-shrink:0;}
  .topbar .nm{font-size:14px;font-weight:700;color:var(--ink);line-height:1.2;}
  .topbar .br{font-size:11.5px;color:var(--muted);}
  .hero{padding:26px 2px 14px;}
  .eyebrow{display:inline-block;font-size:11px;font-weight:800;letter-spacing:0.7px;text-transform:uppercase;color:var(--accent);background:rgba(42,110,244,0.09);padding:5px 11px;border-radius:20px;margin-bottom:14px;}
  h1{font-size:30px;line-height:1.15;margin:0 0 10px;font-weight:800;letter-spacing:-0.5px;}
  .sub{font-size:15.5px;color:var(--muted);margin:0;}
  .card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:20px;margin-top:20px;box-shadow:0 6px 24px rgba(15,27,51,0.06);}
  .card h2{font-size:17px;margin:0 0 4px;font-weight:700;}
  .card .ch{font-size:13px;color:var(--muted);margin:0 0 16px;}
  label{display:block;font-size:12px;font-weight:700;color:var(--ink);margin:12px 0 5px;}
  input{width:100%;font-size:16px;padding:12px 13px;border:1.5px solid var(--line);border-radius:10px;font-family:inherit;outline:none;background:#fff;color:var(--ink);}
  input:focus{border-color:var(--accent);}
  .row2{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
  .btn{width:100%;margin-top:18px;background:var(--accent);color:#fff;border:none;border-radius:12px;padding:15px;font-size:16px;font-weight:800;cursor:pointer;font-family:inherit;letter-spacing:0.2px;}
  .btn:disabled{opacity:0.6;cursor:default;}
  .fine{font-size:11px;color:var(--muted);text-align:center;margin-top:11px;}
  .trust{margin-top:22px;display:flex;flex-direction:column;gap:11px;}
  .trust .t{display:flex;align-items:flex-start;gap:10px;font-size:14px;color:var(--ink);}
  .trust .t .ic{width:22px;height:22px;border-radius:50%;background:rgba(42,110,244,0.12);color:var(--accent);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:800;flex-shrink:0;margin-top:1px;}
  .ftr{text-align:center;margin-top:28px;font-size:12.5px;color:var(--muted);}
  .ftr a{color:var(--accent);text-decoration:none;font-weight:600;}
  .thanks{display:none;text-align:center;padding:40px 10px;}
  .thanks .big{font-size:46px;margin-bottom:10px;}
  .thanks h2{font-size:23px;margin:0 0 8px;}
  .thanks p{font-size:15px;color:var(--muted);margin:0 auto;max-width:380px;}
  .err{display:none;background:#fdecec;color:#b3261e;font-size:13px;border-radius:8px;padding:10px 12px;margin-top:12px;}
</style>
</head>
<body>
<div class="wrap">
  <div id="form-view">
    <div class="topbar">
      <img id="agent-photo" src="" alt="" style="display:none;"/>
      <div>
        <div class="nm" id="agent-name">Your Agent</div>
        <div class="br" id="agent-brokerage"></div>
      </div>
    </div>

    <div class="hero">
      <span class="eyebrow" id="eyebrow">Free Home Valuation</span>
      <h1 id="headline">What&rsquo;s Your Home Worth?</h1>
      <p class="sub" id="subhead">Get a free, no-obligation estimate of your home&rsquo;s current market value &mdash; prepared by a local expert who actually knows your neighborhood.</p>
    </div>

    <div class="card">
      <h2 id="form-title">Get my free home value report</h2>
      <p class="ch" id="form-sub">Takes 20 seconds. No spam, no pressure.</p>

      <label for="f-address">Property address</label>
      <input type="text" id="f-address" placeholder="123 Main St, Westlake, OH" autocomplete="street-address"/>

      <div class="row2">
        <div><label for="f-first">First name</label><input type="text" id="f-first" autocomplete="given-name"/></div>
        <div><label for="f-last">Last name</label><input type="text" id="f-last" autocomplete="family-name"/></div>
      </div>

      <label for="f-email">Email</label>
      <input type="email" id="f-email" placeholder="you@email.com" autocomplete="email"/>

      <label for="f-phone">Phone</label>
      <input type="tel" id="f-phone" placeholder="(440) 555-0123" autocomplete="tel"/>

      <div class="err" id="err"></div>
      <button class="btn" id="submit-btn" onclick="submitLead()">Get My Home Value &rarr;</button>
      <div class="fine">Your information is private and never sold.</div>
    </div>

    <div class="trust">
      <div class="t"><span class="ic">&#10003;</span><span>A real valuation from a local agent &mdash; not an automated guess.</span></div>
      <div class="t"><span class="ic">&#10003;</span><span>No obligation and no cost. Sell now, later, or never.</span></div>
      <div class="t"><span class="ic">&#10003;</span><span>You&rsquo;ll hear back within one business day.</span></div>
    </div>

    <div class="ftr" id="footer"></div>
  </div>

  <div class="thanks" id="thanks-view">
    <div class="big">&#127968;</div>
    <h2>You&rsquo;re all set!</h2>
    <p id="thanks-msg">Thanks &mdash; your request is in. I&rsquo;ll pull together your home&rsquo;s value and reach out shortly.</p>
  </div>
</div>

<script>
  var WORKER_URL = 'https://app.tom-b52.workers.dev';
  var FB_PROJECT = 'buyers-880bc';
  var FB_KEY = 'AIzaSyCy5ZkbPcGtk7I_88dVbNsX40LY-M4R_sY';

  var params = new URLSearchParams(location.search);
  var AGENT = (params.get('a') || 'tom').toLowerCase().replace(/[^a-z0-9]/g,'');
  var TEMPLATE = (params.get('t') || 'valuation').toLowerCase().replace(/[^a-z0-9]/g,'');
  var CFG = {};

  function fsVal(v){
    if(!v) return '';
    if(v.stringValue!==undefined) return v.stringValue;
    if(v.integerValue!==undefined) return v.integerValue;
    if(v.booleanValue!==undefined) return v.booleanValue;
    return '';
  }
  function setText(id, val){ var el=document.getElementById(id); if(el && val) el.textContent=val; }

  function applyConfig(c){
    CFG = c || {};
    if(c.accent){ document.documentElement.style.setProperty('--accent', c.accent); }
    setText('agent-name', c.agentName);
    setText('agent-brokerage', c.brokerage);
    if(c.agentPhoto){ var ph=document.getElementById('agent-photo'); ph.src=c.agentPhoto; ph.style.display='block'; }
    setText('eyebrow', c.eyebrow);
    setText('headline', c.headline);
    setText('subhead', c.subhead);
    setText('form-title', c.formTitle);
    if(c.ctaText){ document.getElementById('submit-btn').innerHTML = c.ctaText + ' \u2192'; }
    if(document.title && c.headline){ document.title = c.headline; }
    var ftr=document.getElementById('footer');
    var bits=[];
    if(c.agentName) bits.push(c.agentName);
    if(c.agentPhone) bits.push('<a href="tel:'+String(c.agentPhone).replace(/[^0-9+]/g,'')+'">'+c.agentPhone+'</a>');
    if(c.agentEmail) bits.push('<a href="mailto:'+c.agentEmail+'">'+c.agentEmail+'</a>');
    if(bits.length) ftr.innerHTML = bits.join(' &middot; ');
  }

  function loadConfig(){
    var docId = AGENT + '_' + TEMPLATE;
    var url = 'https://firestore.googleapis.com/v1/projects/'+FB_PROJECT+'/databases/(default)/documents/landing_pages/'+docId+'?key='+FB_KEY;
    fetch(url).then(function(r){ return r.ok ? r.json() : null; }).then(function(d){
      if(d && d.fields){
        var c={};
        Object.keys(d.fields).forEach(function(k){ c[k]=fsVal(d.fields[k]); });
        applyConfig(c);
      }
    }).catch(function(){});
  }

  function showErr(msg){ var e=document.getElementById('err'); e.textContent=msg; e.style.display='block'; }

  function submitLead(){
    var first=document.getElementById('f-first').value.trim();
    var last=document.getElementById('f-last').value.trim();
    var email=document.getElementById('f-email').value.trim();
    var phone=document.getElementById('f-phone').value.trim();
    var address=document.getElementById('f-address').value.trim();
    document.getElementById('err').style.display='none';

    if(!address){ showErr('Please enter your property address.'); return; }
    if(!first){ showErr('Please enter your first name.'); return; }
    if(!email && !phone){ showErr('Please enter an email or phone so we can reach you.'); return; }

    var btn=document.getElementById('submit-btn');
    btn.disabled=true; btn.textContent='Sending\u2026';

    var payload={
      firstName:first, lastName:last, email:email, phone:phone, address:address,
      agentId:AGENT, source:(CFG.source || 'Home Valuation'),
      notes:'Home valuation request via landing page for: '+address
    };
    fetch(WORKER_URL, {
      method:'POST',
      headers:{'Content-Type':'application/json','X-Action':'inbound-lead'},
      body:JSON.stringify(payload)
    }).then(function(r){ return r.json().catch(function(){return {};}); }).then(function(){
      if(CFG.thanksMsg){ document.getElementById('thanks-msg').textContent=CFG.thanksMsg; }
      document.getElementById('form-view').style.display='none';
      document.getElementById('thanks-view').style.display='block';
      window.scrollTo(0,0);
    }).catch(function(){
      btn.disabled=false; btn.innerHTML='Get My Home Value \u2192';
      showErr('Something went wrong. Please try again, or call us directly.');
    });
  }

  loadConfig();
</script>
</body>
</html>
